  <!-- FLOATING AI CHATBOT WIDGET -->
  <div class="chatbot-widget" id="chatbot-widget">
    <!-- Chatbot Window -->
    <div class="chatbot-box">
      <!-- Header -->
      <div class="chatbot-header">
        <div class="chatbot-header-avatar">
          <i class="fas fa-robot"></i>
        </div>
        <div class="chatbot-header-info">
          <h4>MISTRO AI Assistant</h4>
          <p>Online | Quick Booking Help</p>
        </div>
        <button id="chatbot-close" style="background:none; border:none; color:white; margin-left:auto; cursor:pointer; font-size:1.1rem;" onclick="document.getElementById('chatbot-widget').classList.remove('active');">
          <i class="fas fa-times"></i>
        </button>
      </div>
      
      <!-- Messages Panel -->
      <div class="chatbot-messages" id="chatbot-messages">
        <div class="chat-bubble bot">
          Hello! I am MISTRO AI Assistant. How can I help you book today?
        </div>
      </div>
      
      <!-- Suggested Chips -->
      <div class="chatbot-chips">
        <span class="chat-chip" data-topic="electrician">Find Electrician</span>
        <span class="chat-chip" data-topic="emergency">Emergency Repair Help</span>
        <span class="chat-chip" data-topic="recommendations">Service Recommendations</span>
        <span class="chat-chip" data-topic="guidance">Booking Guidance</span>
        <span class="chat-chip" data-topic="suggestions">Worker Suggestions</span>
      </div>
      
      <!-- Input Area -->
      <div class="chatbot-input-container">
        <input type="text" id="chatbot-input" class="chatbot-input" placeholder="Ask MISTRO AI anything...">
        <button id="chatbot-send" class="chatbot-send-btn">
          <i class="fas fa-paper-plane"></i>
        </button>
      </div>
    </div>
    
    <!-- Floating toggle button -->
    <button class="chatbot-toggle-btn" id="chatbot-toggle">
      <i class="fas fa-comment-dots"></i>
    </button>
  </div>

  <script src="app.js"></script>
  <script>
    // Custom trigger hook for the promo video buttons that might be added
    document.getElementById('play-promo-video-btn').addEventListener('click', () => {
      document.getElementById('play-promo-video').click();
    });
  </script>
</body>

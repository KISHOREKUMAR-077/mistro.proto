        <h3>Emergency Mode</h3>
        <p>Dedicated SOS layout option to prioritize high-risk electrical switchboard or major water leaks.</p>
      </div>
      
      <!-- 6 -->
      <div class="glass-card future-card">
        <div class="future-card-icon"><i class="fas fa-chart-bar"></i></div>
        <h3>Analytics Dashboard</h3>
        <p>Detailed income statements, job trends, and feedback reports for registered workers.</p>
      </div>
      
      <!-- 7 -->
      <div class="glass-card future-card">
        <div class="future-card-icon"><i class="fas fa-id-card"></i></div>
        <h3>Worker Verification System</h3>
        <p>Automated, secure API matching for background checks and utility validation protocols.</p>
      </div>
      
      <!-- 8 -->
      <div class="glass-card future-card">
        <div class="future-card-icon"><i class="fas fa-mobile-alt"></i></div>
        <h3>Native Mobile App</h3>
        <p>Dedicated Android & iOS builds utilizing hardware features (push notifications, background locations).</p>
      </div>
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <section class="section reveal" id="contact">
    <div class="section-header">
      <span class="section-tag">Get in Touch</span>
      <h2 class="section-title">Contact MISTRO</h2>
      <p class="section-desc">Connect with our team to request a custom partnership, feedback, or review the project.</p>
    </div>
    
    <div class="contact-grid">
      <!-- Info Left -->
      <div class="contact-info">
        <div class="contact-details">
          <div class="contact-item">
            <div class="contact-icon"><i class="fas fa-envelope"></i></div>
            <div class="contact-text">
              <h4>Email Us</h4>
              <p>mistro.startup@gmail.com</p>
            </div>
          </div>
          
          <div class="contact-item">
            <div class="contact-icon"><i class="fas fa-map-marker-alt"></i></div>
            <div class="contact-text">
              <h4>Location</h4>
              <p>Sri Sairam Engineering College, Chennai, TN, India</p>
            </div>
          </div>
        </div>
        
        <div class="contact-ctas">
          <!-- Reference local PDF file -->
          <a href="MISTRO.....pdf" class="btn-primary" download="MISTRO_Project_Report.pdf">
            <i class="fas fa-file-pdf"></i> Download Project Report
          </a>
          <a href="#app-preview" class="btn-secondary">
            <i class="fas fa-mobile"></i> View Interactive Demo
          </a>
        </div>
      </div>
      
      <!-- Contact Form Right -->
      <div class="glass-card contact-form-card">
        <form action="#" onsubmit="event.preventDefault(); alert('Thank you! Your message has been sent successfully. We will contact you soon.');">
          <div class="form-group">
            <label class="form-label" for="contact-name">Full Name</label>
            <input type="text" id="contact-name" class="form-control" placeholder="Enter your name" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-email">Email Address</label>
            <input type="email" id="contact-email" class="form-control" placeholder="Enter your email" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-phone">Phone Number</label>
            <input type="tel" id="contact-phone" class="form-control" placeholder="Enter your phone number">
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-message">Message</label>
            <textarea id="contact-message" class="form-control" rows="4" placeholder="Enter your message details..." required></textarea>
          </div>
          <button type="submit" class="btn-accent" style="width: 100%; justify-content: center;">Send Message</button>
        </form>
      </div>
    </div>
  </section>


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Favicon Logo -->
  <link rel="icon" type="image/png" href="logo.png.png">
  
  <!-- SEO Meta Tags -->
  <title>MISTRO - Service On. Stress Gone. | Home Services Marketplace</title>
  <meta name="description" content="MISTRO is an innovative home services marketplace platform connecting customers with trusted local professionals instantly. Discover electricians, plumbers, painters, and more.">
  <meta name="keywords" content="Home services, Electrician, Plumber, AC Repair, India, Startup, Sri Sairam Engineering, MISTRO">
  <meta name="author" content="Mithilesh, Sanjay, Kishore Kumar">
  
  <!-- Theme Color for browsers -->
  <meta name="theme-color" content="#1E3A8A">
  
  <!-- CDNs for Fonts & Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="style.css">
  
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

  <!-- Cursor Glow Effect -->
  <div id="cursor-glow"></div>

  <!-- FIXED GLASSMORPHIC NAVBAR -->
  <nav class="navbar" id="navbar">
    <a href="#" class="nav-logo-container">
      <img src="logo.png.png" class="nav-logo-img" alt="MISTRO Logo">
      <span class="nav-logo-text">MISTRO</span>
    </a>
    
    <ul class="nav-links">
      <li><a href="#problem">Problem</a></li>
      <li><a href="#solution">Solution</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#app-preview">App Preview</a></li>
      <li><a href="#market">Opportunity</a></li>
    </ul>
    
    <div class="nav-actions">
      <div class="theme-switch-container">
        <label class="theme-switch" for="theme-toggle-input">
          <input type="checkbox" id="theme-toggle-input" />
          <span class="slider">
            <i class="fas fa-sun"></i>
            <i class="fas fa-moon"></i>
          </span>
        </label>
      </div>
      <a href="#contact" class="btn-primary" style="padding: 10px 20px; font-size: 0.9rem;">Book Now</a>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <header class="hero" id="hero">
    <div class="particles-container" id="hero-particles"></div>
    
    <!-- Floating Icons in Background -->
    <div class="floating-icons-container">
      <i class="fas fa-plug floating-icon"></i>
      <i class="fas fa-wrench floating-icon"></i>
      <i class="fas fa-hammer floating-icon"></i>
      <i class="fas fa-screwdriver floating-icon"></i>
      <i class="fas fa-faucet floating-icon"></i>
      <i class="fas fa-cog floating-icon"></i>
      <i class="fas fa-bolt floating-icon"></i>
    </div>
    
    <div class="hero-content">
      <!-- Centered MISTRO Logo -->
      <div class="hero-logo-wrapper">
        <div class="hero-glow-back"></div>
        <img src="logo.png.png" class="hero-logo-img" alt="MISTRO Logo">
      </div>
      
      <h1>MISTRO</h1>
      
      <!-- Animated Typing Tagline -->
      <div class="typing-tagline">
        <span id="typing-text" data-tagline="Service On. Stress Gone."></span>
        <span class="typing-cursor"></span>
      </div>
      
      <p class="hero-desc">
        An innovative local services marketplace platform connecting customers with trusted, skilled professionals instantly.
      </p>
      
      <div class="hero-ctas">
        <a href="#contact" class="btn-accent">Book a Service</a>
        <a href="#app-preview" class="btn-primary">Join as Professional</a>
        <button id="play-promo-video" class="btn-secondary">
          <i class="fas fa-play"></i> Watch MISTRO Demo
        </button>
      </div>
    </div>
    
    <!-- Live Activity Ticker -->
    <div class="ticker-container">
      <div class="ticker-wrap">
        <div class="ticker-content">
          <div class="ticker-item">
            <span class="ticker-dot"></span>
            <span>Electrician booked 2 mins ago in Chennai</span>
          </div>
          <div class="ticker-item">
            <span class="ticker-dot"></span>
            <span>AC Repair completed in Bangalore</span>
          </div>
          <div class="ticker-item">
            <span class="ticker-dot"></span>
            <span>Suresh (Carpenter) joined the platform</span>
          </div>
          <div class="ticker-item">
            <span class="ticker-dot"></span>
            <span>Water purifier maintenance completed in Tambaram</span>
          </div>
          <div class="ticker-item">
            <span class="ticker-dot"></span>
            <span>Plumber booked 10 mins ago in Adyar</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- PROBLEM STATEMENT SECTION -->
  <section class="section reveal" id="problem">
    <div class="section-header">
      <span class="section-tag">Challenges</span>
      <h2 class="section-title">The Problem We Solve</h2>
      <p class="section-desc">Traditional home services in India face major challenges on both ends of the marketplace.</p>
    </div>
    
    <div class="grid-2">
      <!-- Customer Side -->
      <div class="glass-card customer-issues">
        <h3 class="problem-column-title">
          <i class="fas fa-users" style="color: #ef4444;"></i> Customer Problems
        </h3>
        <ul class="problem-list">
          <li class="problem-item">
            <i class="fas fa-search"></i> Finding reliable workers is difficult
          </li>
          <li class="problem-item">
            <i class="fas fa-clock"></i> Emergency repairs take too long
          </li>
          <li class="problem-item">
            <i class="fas fa-star-half-alt"></i> No transparent ratings or reviews
          </li>
          <li class="problem-item">
            <i class="fas fa-balance-scale"></i> Difficulty comparing workers and rates
          </li>
          <li class="problem-item">
            <i class="fas fa-shield-alt"></i> Lack of trust in local services
          </li>
        </ul>
      </div>
      
      <!-- Worker Side -->
      <div class="glass-card worker-issues">
        <h3 class="problem-column-title">
          <i class="fas fa-toolbox" style="color: var(--accent);"></i> Worker Problems
        </h3>
        <ul class="problem-list">
          <li class="problem-item">
            <i class="fas fa-calendar-times"></i> Irregular job opportunities
          </li>
          <li class="problem-item">
            <i class="fas fa-chart-line-down"></i> Unstable and low monthly income
          </li>
          <li class="problem-item">
            <i class="fas fa-user-slash"></i> Heavy dependence on middlemen
          </li>
          <li class="problem-item">
            <i class="fas fa-eye-slash"></i> Low local visibility for services
          </li>
          <li class="problem-item">
            <i class="fas fa-mobile-alt"></i> Lack of digital access and empowerment
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- REAL-LIFE PROBLEM SCENARIO -->
  <section class="section reveal" id="scenario">
    <div class="scenario-section">
      <div class="scenario-header">
        <span class="section-tag">Real-World Context</span>
        <h2 class="section-title">A Day in the Life of an Indian Household</h2>
      </div>
      
      <div class="scenario-grid">
        <div class="scenario-story">
          <div class="story-step">
            <span class="step-num">1</span>
            <div class="story-text">
              <h4>Sudden Power Outage</h4>
              <p>A family in Chennai experiences a sudden switchboard sparks and power outage in their living room.</p>
            </div>
          </div>
          
          <div class="story-step">
            <span class="step-num">2</span>
            <div class="story-text">
              <h4>The Hunt for Help</h4>
              <p>The customer spends 30 minutes dialing local numbers, asking neighbors, and looking on local business registers.</p>
            </div>
          </div>
          
          <div class="story-step">
            <span class="step-num">3</span>
            <div class="story-text">
              <h4>Failed Calls</h4>
              <p>Multiple electricians are busy, live too far, or demand exorbitant upfront charges without visiting.</p>
            </div>
          </div>
          
          <div class="story-step">
            <span class="step-num">4</span>
            <div class="story-text">
              <h4>Escalating Stress</h4>
              <p>Appliances stay off, food spoils, and stress rises. Time is wasted looking for a simple fix.</p>
            </div>
          </div>
        </div>
        
        <div class="scenario-display">
          <i class="fas fa-house-damage"></i>
          <h3>"Finding reliable service shouldn't be this difficult."</h3>
          <p>This is where MISTRO steps in.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MISTRO SOLUTION SECTION -->
  <section class="section reveal" id="solution">
    <div class="section-header">
      <span class="section-tag">Our Solution</span>
      <h2 class="section-title">Meet MISTRO</h2>
      <p class="section-desc">We bridge the gap with an easy-to-use digital platform that matches skilled professionals with urban households instantly.</p>
    </div>
    
    <div class="solution-container">
      <!-- Left Column Features -->
      <div class="solution-cards-left">
        <div class="glass-card solution-card">
          <div class="solution-card-icon"><i class="fas fa-bolt"></i></div>
          <div class="solution-card-info">
            <h4>Instant Booking</h4>
            <p>Order a technician in under 30 seconds.</p>
          </div>
        </div>
        
        <div class="glass-card solution-card">
          <div class="solution-card-icon"><i class="fas fa-map-marker-alt"></i></div>
          <div class="solution-card-info">
            <h4>Nearby Workers</h4>
            <p>Find professionals working within a 2-5km radius.</p>
          </div>
        </div>
        
        <div class="glass-card solution-card">
          <div class="solution-card-icon"><i class="fas fa-star"></i></div>
          <div class="solution-card-info">
            <h4>Verified Ratings</h4>
            <p>Check authentic ratings and reviews from previous customers.</p>
          </div>
        </div>
        
        <div class="glass-card solution-card">
          <div class="solution-card-icon"><i class="fas fa-user-check"></i></div>
          <div class="solution-card-info">
            <h4>Trusted Professionals</h4>
            <p>All workers undergo thorough KYC and background verification.</p>
          </div>
        </div>
      </div>
      
      <!-- Center Phone Mockup -->
      <div class="mockup-wrapper">
        <div class="phone-mockup">
          <div class="phone-screen">
            <!-- Simulated Active Dashboard Screen for visual -->
            <div class="app-screen-frame" style="padding: 25px 15px 15px 15px;">
              <div class="app-header">
                <span>9:41 AM</span>
                <div>
                  <i class="fas fa-signal"></i>
                  <i class="fas fa-wifi"></i>
                  <i class="fas fa-battery-three-quarters"></i>
                </div>
              </div>
              <div class="app-dashboard-header">
                <div class="app-dashboard-user">
                  <div class="app-avatar" style="background: var(--accent);">K</div>
                  <div>
                    <h5 style="font-size: 0.8rem; margin:0;">Hi, Kishore!</h5>
                    <p style="font-size: 0.65rem; color: #94a3b8; margin:0;"><i class="fas fa-map-marker-alt" style="color: var(--accent);"></i> Chennai, IN</p>
                  </div>
                </div>
                <i class="fas fa-bell" style="color: #94a3b8;"></i>
              </div>
              <div class="app-search" style="margin-bottom: 20px;">
                <i class="fas fa-search"></i>
                <span>Search for electrician, plumber...</span>
              </div>
              <p style="font-size: 0.75rem; font-weight: 700; margin-bottom: 10px;">Our Services</p>
              <div class="app-service-grid">
                <div class="app-service-item">
                  <div class="app-service-icon" style="background: rgba(249,115,22,0.2); color: var(--accent);"><i class="fas fa-plug"></i></div>
                  <span>Electrical</span>
                </div>
                <div class="app-service-item">
                  <div class="app-service-icon" style="background: rgba(59,130,246,0.2); color: #3b82f6;"><i class="fas fa-wrench"></i></div>
                  <span>Plumbing</span>
                </div>
                <div class="app-service-item">
                  <div class="app-service-item">
                    <div class="app-service-icon" style="background: rgba(34,197,94,0.2); color: #22c55e;"><i class="fas fa-hammer"></i></div>
                    <span>Carpentry</span>
                  </div>
                </div>
                <div class="app-service-item">
                  <div class="app-service-icon" style="background: rgba(239,68,68,0.2); color: #ef4444;"><i class="fas fa-snowflake"></i></div>
                  <span>AC Repair</span>
                </div>
              </div>
              <div class="app-dashboard-banner" style="margin-top: 15px;">
                <h5 style="font-size: 0.75rem; margin:0;">Emergency Repair?</h5>
                <p style="font-size: 0.6rem; margin: 5px 0 0 0; opacity: 0.8;">Tap below to alert nearest technicians instantly.</p>
                <button style="margin-top: 8px; font-size: 0.65rem; background: var(--accent); border:none; padding:4px 8px; border-radius:4px; color:white; font-weight:600;">SOS Help</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Right Column Features -->
      <div class="solution-cards-right">
        <div class="glass-card solution-card">
          <div class="solution-card-icon"><i class="fas fa-shipping-fast"></i></div>
          <div class="solution-card-info">
            <h4>Fast Response</h4>
            <p>Workers arrive within 30-45 minutes of booking.</p>
          </div>
        </div>
        
        <div class="glass-card solution-card">
          <div class="solution-card-icon"><i class="fas fa-comments"></i></div>
          <div class="solution-card-info">
            <h4>Easy Communication</h4>
            <p>Integrated chat and calling options for hassle-free updates.</p>
          </div>
        </div>
        
        <div class="glass-card solution-card">
          <div class="solution-card-icon"><i class="fas fa-brain"></i></div>
          <div class="solution-card-info">
            <h4>Smart Recommendations</h4>
            <p>Our algorithms match you with the best available worker.</p>
          </div>
        </div>
        
        <div class="glass-card solution-card">
          <div class="solution-card-icon"><i class="fas fa-exclamation-triangle"></i></div>
          <div class="solution-card-info">
            <h4>Emergency Support</h4>
            <p>One-tap SOS dispatch for critical utility failures.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW MISTRO WORKS -->
  <section class="section reveal" id="how-works">
    <div class="section-header">
      <span class="section-tag">Workflow</span>
      <h2 class="section-title">How MISTRO Works</h2>
      <p class="section-desc">A seamless, interactive process designed to match resources in seconds.</p>
    </div>
    
    <div class="timeline-container">
      <div class="timeline-line">
        <div class="timeline-progress" id="timeline-progress" style="width: 100%;"></div>
      </div>
      
      <div class="timeline-steps">
        <!-- Step 1 -->
        <div class="timeline-step active">
          <div class="timeline-icon-box"><i class="fas fa-search"></i></div>
          <h3>Search Service</h3>
          <p>Choose from our extensive list of local repair categories.</p>
        </div>
        
        <!-- Step 2 -->
        <div class="timeline-step active">
          <div class="timeline-icon-box"><i class="fas fa-user-tie"></i></div>
          <h3>Choose Pro</h3>
          <p>Compare profiles, reviews, and hourly rates transparently.</p>
        </div>
        
        <!-- Step 3 -->
        <div class="timeline-step active">
          <div class="timeline-icon-box"><i class="fas fa-calendar-check"></i></div>
          <h3>Book Appt</h3>
          <p>Confirm the booking and track technician arrival status.</p>
        </div>
        
        <!-- Step 4 -->
        <div class="timeline-step active">
          <div class="timeline-icon-box"><i class="fas fa-check-circle"></i></div>
          <h3>Service Done</h3>
          <p>Review work done, pay digitally, and rate your professional.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES SECTION -->
  <section class="section reveal" id="services">
    <div class="section-header">
      <span class="section-tag">Offerings</span>
      <h2 class="section-title">Our Services</h2>
      <p class="section-desc">On-demand, premium quality services for all your household utilities.</p>
    </div>
    
    <div class="grid-4 services-grid">
      <!-- Card 1 -->
      <div class="glass-card service-card">
        <div class="service-icon-wrapper"><i class="fas fa-plug"></i></div>
        <h3>Electrical Services</h3>
        <p>Switchboards, wiring repairs, light installations, and emergency troubleshooting.</p>
      </div>
      
      <!-- Card 2 -->
      <div class="glass-card service-card">
        <div class="service-icon-wrapper"><i class="fas fa-wrench"></i></div>
        <h3>Plumbing Services</h3>
        <p>Leaking pipe fixes, tap fittings, bathroom utility installations, and drainage cleaning.</p>
      </div>
      
      <!-- Card 3 -->
      <div class="glass-card service-card">
        <div class="service-icon-wrapper"><i class="fas fa-hammer"></i></div>
        <h3>Carpentry Services</h3>
        <p>Door repairs, custom shelving, furniture assembly, and latch alignments.</p>
      </div>
      
      <!-- Card 4 -->
      <div class="glass-card service-card">
        <div class="service-icon-wrapper"><i class="fas fa-snowflake"></i></div>
        <h3>AC Repair</h3>
        <p>Filter cleaning, gas filling, cooling maintenance, and compressor repairs.</p>
      </div>
      
      <!-- Card 5 -->
      <div class="glass-card service-card">
        <div class="service-icon-wrapper"><i class="fas fa-paint-roller"></i></div>
        <h3>Painting</h3>
        <p>Interior wall touch-ups, waterproof coatings, trim paints, and full house re-paints.</p>
      </div>
      
      <!-- Card 6 -->
      <div class="glass-card service-card">
        <div class="service-icon-wrapper"><i class="fas fa-tv"></i></div>
        <h3>Appliance Repair</h3>
        <p>Washing machine leaks, refrigerator cooling issues, microwave failures, and repairs.</p>
      </div>
      
      <!-- Card 7 -->
      <div class="glass-card service-card">
        <div class="service-icon-wrapper"><i class="fas fa-microchip"></i></div>
        <h3>Electronics Repair</h3>
        <p>Television mounting, soundbar installation, smart device setup, and diagnostic fixes.</p>
      </div>
      
      <!-- Card 8 -->
      <div class="glass-card service-card">
        <div class="service-icon-wrapper"><i class="fas fa-faucet"></i></div>
        <h3>Water Maintenance</h3>
        <p>Water tank cleaning, purifier filter replacements, and motor repair services.</p>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE MISTRO -->
  <section class="section reveal" id="why-choose">
    <div class="section-header">
      <span class="section-tag">Value Proposition</span>
      <h2 class="section-title">Why Choose MISTRO</h2>
      <p class="section-desc">We represent the next generation of home service marketplaces, prioritizing safety and quality.</p>
    </div>
    
    <div class="grid-4 why-grid">
      <!-- 1 -->
      <div class="glass-card why-card">
        <i class="fas fa-user-shield why-icon"></i>
        <div class="why-info">
          <h3>Trusted Professionals</h3>
          <p>Every worker undergoes rigorous background checks.</p>
        </div>
      </div>
      <!-- 2 -->
      <div class="glass-card why-card">
        <i class="fas fa-mobile-alt why-icon"></i>
        <div class="why-info">
          <h3>Easy Booking</h3>
          <p>Clean app experience built for quick checkout.</p>
        </div>
      </div>
      <!-- 3 -->
      <div class="glass-card why-card">
        <i class="fas fa-map-marked-alt why-icon"></i>
        <div class="why-info">
          <h3>Nearby Discovery</h3>
          <p>GPS tracking matches you to local providers instantly.</p>
        </div>
      </div>
      <!-- 4 -->
      <div class="glass-card why-card">
        <i class="fas fa-tags why-icon"></i>
        <div class="why-info">
          <h3>Affordable Solutions</h3>
          <p>Fair, fixed rates without hidden service markups.</p>
        </div>
      </div>
      <!-- 5 -->
      <div class="glass-card why-card">
        <i class="fas fa-comments-dollar why-icon"></i>
        <div class="why-info">
          <h3>Verified Reviews</h3>
          <p>True star ratings that build reliable reputations.</p>
        </div>
      </div>
      <!-- 6 -->
      <div class="glass-card why-card">
        <i class="fas fa-shipping-fast why-icon"></i>
        <div class="why-info">
          <h3>Quick Response Time</h3>
          <p>Average technician response under 45 minutes.</p>
        </div>
      </div>
      <!-- 7 -->
      <div class="glass-card why-card">
        <i class="fas fa-people-carry why-icon"></i>
        <div class="why-info">
          <h3>Worker Empowerment</h3>
          <p>Bypassing middlemen to double worker earnings.</p>
        </div>
      </div>
      <!-- 8 -->
      <div class="glass-card why-card">
        <i class="fas fa-tablet-alt why-icon"></i>
        <div class="why-info">
          <h3>Modern Experience</h3>
          <p>Interactive dashboard, live tracking, and support chat.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ANIMATED LIVE STATISTICS -->
  <section class="stats-section reveal" id="statistics">
    <div class="stats-grid">
      <div class="stat-item">
        <h3 class="stat-number" data-target="500" data-suffix="+">0+</h3>
        <p>Skilled Workers</p>
      </div>
      <div class="stat-item">
        <h3 class="stat-number" data-target="1000" data-suffix="+">0+</h3>
        <p>Bookings Completed</p>
      </div>
      <div class="stat-item">
        <h3 class="stat-number" data-target="95" data-suffix="%">0%</h3>
        <p>Satisfaction Rate</p>
      </div>
      <div class="stat-item">
        <h3 class="stat-number" data-target="4.8" data-suffix="★">0★</h3>
        <p>Average Rating</p>
      </div>
      <div class="stat-item">
        <h3 class="stat-number" data-target="50" data-suffix="+">0+</h3>
        <p>Locations Covered</p>
      </div>
    </div>
  </section>

  <!-- APP PREVIEW SECTION (INTERACTIVE PHONE SCREENS) -->
  <section class="section reveal" id="app-preview">
    <div class="section-header">
      <span class="section-tag">Interactive App</span>
      <h2 class="section-title">Explore the MISTRO Application</h2>
      <p class="section-desc">Click any screen module on the left to preview the premium mobile user experience on the mockup screen.</p>
    </div>
    
    <div class="app-preview-section">
      <!-- Selector buttons -->
      <div class="app-screen-selector-grid">
        <button class="screen-select-btn active" data-screen="splash">
          <i class="fas fa-rocket"></i>
          <span>1. Splash Screen</span>
        </button>
        <button class="screen-select-btn" data-screen="login">
          <i class="fas fa-sign-in-alt"></i>
          <span>2. Login Page</span>
        </button>
        <button class="screen-select-btn" data-screen="signup">
          <i class="fas fa-user-plus"></i>
          <span>3. Signup Page</span>
        </button>
        <button class="screen-select-btn" data-screen="dashboard">
          <i class="fas fa-th-large"></i>
          <span>4. Home Dashboard</span>
        </button>
        <button class="screen-select-btn" data-screen="profile-view">
          <i class="fas fa-id-badge"></i>
          <span>5. Worker Profile</span>
        </button>
        <button class="screen-select-btn" data-screen="booking">
          <i class="fas fa-receipt"></i>
